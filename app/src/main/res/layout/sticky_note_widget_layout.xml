<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 可动态染色的圆角背景底板 -->
    <ImageView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_fill_26" />

    <!-- 实体便利贴风格的顶部主题色带（其他风格隐藏） -->
    <ImageView
        android:id="@+id/widget_header_band"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_header_band_24"
        android:visibility="gone" />

    <!-- 可动态染色的圆角描边层（深色与经典风格隐藏） -->
    <ImageView
        android:id="@+id/widget_stroke_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_stroke_26"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <RelativeLayout
            android:id="@+id/widget_header_row"
            android:layout_width="match_parent"
            android:layout_height="28dp">

            <LinearLayout
                android:id="@+id/widget_right_group"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_last_sync_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="2dp"
                    android:text="--:--"
                    android:textSize="11sp"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/widget_refresh_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="&#x21BB;"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_left_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/widget_right_group"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/widget_add_container"
                    android:layout_width="24dp"
                    android:layout_height="24dp">

                    <ImageView
                        android:id="@+id/widget_add_badge_bg"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_shape_pill"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_add_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="+"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- 顶部快速筛选 Tab：全部 / 未完成 / 已完成 -->
                <LinearLayout
                    android:id="@+id/widget_filter_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/widget_tab_all"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp">

                        <ImageView
                            android:id="@+id/widget_tab_all_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_shape_pill"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/widget_tab_all_text"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:singleLine="true"
                            android:text="全部"
                            android:textSize="11.5sp" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/widget_tab_active"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginStart="2dp">

                        <ImageView
                            android:id="@+id/widget_tab_active_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_shape_pill"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/widget_tab_active_text"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:singleLine="true"
                            android:text="未完成"
                            android:textSize="11.5sp" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/widget_tab_completed"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginStart="2dp">

                        <ImageView
                            android:id="@+id/widget_tab_completed_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_shape_pill"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/widget_tab_completed_text"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:singleLine="true"
                            android:text="已完成"
                            android:textSize="11.5sp" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <FrameLayout
            android:id="@+id/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp" />

        <FrameLayout
            android:id="@+id/widget_list_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/widget_todo_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:cacheColorHint="@android:color/transparent"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:fadeScrollbars="true"
                android:fadingEdgeLength="12dp"
                android:scrollbarStyle="outsideInset"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/widget_empty_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical|start"
                android:paddingStart="2dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="暂无待办"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
